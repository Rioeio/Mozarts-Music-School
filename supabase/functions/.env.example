# ==============================================================================
# SUPABASE EDGE FUNCTION SECRETS (server-side only, never VITE_)
# ==============================================================================
# Hosted:  supabase secrets set --env-file supabase/functions/.env.production
#          (create that file from this template; it is git-ignored)
# Local:   supabase functions serve --env-file supabase/functions/.env.local
#
# SUPABASE_URL, SUPABASE_ANON_KEY and SUPABASE_SERVICE_ROLE_KEY are injected by
# Supabase automatically, locally and hosted. Do not set them here.
# All values below are placeholders and are rejected by the functions.
# ------------------------------------------------------------------------------

# Exact browser origins allowed to call the functions (comma-separated, no *,
# no wildcards). Production project: the Vercel production domain only, e.g.
#   ALLOWED_ORIGINS=https://your-production-domain.example
# Add one explicit preview/testing origin (e.g. https://preview.your-domain)
# only on the Supabase project that preview builds use. Never list
# *.vercel.app. Add http://localhost:8443 only on a development project.
ALLOWED_ORIGINS=https://your-production-domain.example,http://localhost:8443

# Public site origin used in invitation/password-reset links (https). The
# Vercel production domain, the same value as Supabase Auth's Site URL.
SITE_URL=https://your-production-domain.example

# Where new-enquiry alerts are sent.
OWNER_EMAIL=owner@your-verified-domain.example

# Cloudflare Turnstile *secret* key (Turnstile > your widget > Settings).
# Local only: 1x0000000000000000000000000000000AA (always passes; refused when
# SUPABASE_URL is not a local stack).
TURNSTILE_SECRET_KEY=your-turnstile-secret-key
# Optional: hostnames Turnstile tokens must come from. Defaults to the
# hostnames in ALLOWED_ORIGINS (usually what you want). Every hostname here
# must also be listed on the Turnstile widget in the Cloudflare dashboard.
# TURNSTILE_ALLOWED_HOSTNAMES=your-production-domain.example

# Number of trusted proxies that append to X-Forwarded-For in front of the
# function (1 = use the right-most entry). See DEPLOYMENT.md before changing.
CLIENT_IP_TRUSTED_PROXY_HOPS=1

# Resend (https://resend.com) API key and a sender on a domain verified in Resend.
RESEND_API_KEY=re_your_resend_api_key
FROM_EMAIL=Mozart School <enquiries@your-verified-domain.example>

# "resend" (default) or "log". "log" prints instead of sending and is refused
# unless SUPABASE_URL is a local stack.
EMAIL_DELIVERY_MODE=resend

# Shared secret the scheduler sends as the x-cron-secret header to
# process-notifications. At least 32 random characters, e.g.
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Store the same value in Supabase Vault as notifications_cron_secret.
NOTIFICATIONS_CRON_SECRET=replace-me-with-at-least-32-random-characters
