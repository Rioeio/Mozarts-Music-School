# ==============================================================================
# MOZART SCHOOL OF WESTERN CLASSICAL MUSIC - FRONTEND BUILD CONFIGURATION
# ==============================================================================
# Copy to .env.local for local development (git ignores every .env* file except
# this one). Every value below is a placeholder; the app refuses to start its
# online features while placeholders remain.
#
# Everything in this file is PUBLIC: VITE_ variables are embedded in the
# JavaScript sent to every visitor. Never put a service-role key, Resend key,
# Turnstile secret or any other secret here. Server secrets belong in Supabase
# (see supabase/functions/.env.example and DEPLOYMENT.md).
#
# On Vercel: Project Settings > Environment Variables, set separately for the
# Production and Preview environments. Vite reads them during the build, so
# redeploy after changing any of them.
# ------------------------------------------------------------------------------

# Supabase project URL (Project Settings > API). Must be https in builds.
VITE_SUPABASE_URL=https://your-project-id.supabase.co

# Supabase anon (legacy JWT) or publishable (sb_publishable_...) key.
# The app refuses service-role / sb_secret_ keys.
VITE_SUPABASE_ANON_KEY=your-anon-or-publishable-key

# Cloudflare Turnstile *site* key (public). Local testing can use Cloudflare's
# always-pass test key 1x00000000000000000000AA; builds reject test keys.
VITE_TURNSTILE_SITE_KEY=your-turnstile-site-key

# Local dev server only: run against browser-storage demo data with a visible
# DEMO MODE banner (same as `npm run dev:mock`). Ignored by every build; do not
# set it on Vercel.
# VITE_ENABLE_MOCK_BACKEND=true

# ------------------------------------------------------------------------------
# Build-time search indexing (read by vite.config.ts, not sent to the browser)
# ------------------------------------------------------------------------------
# "true" only for the public production site (Vercel: Production environment
# only). Anything else emits noindex/nofollow and a robots.txt that disallows
# crawling. Vercel Preview builds are never indexable, whatever this says.
SITE_INDEXING=false
# Public site origin, used for the canonical link when indexing is enabled.
SITE_URL=https://your-production-domain.example
